PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
BLOB_DIRECTORY=.data/blobs
BLOB_STORAGE=local
# Hosted attachments use BLOB_STORAGE=s3 and a private Supabase bucket.
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set this in Render alongside its production DATABASE_URL; keep local DATABASE_URL unchanged.
SUPABASE_PROJECT_REF=
MAX_UPLOAD_BYTES=20971520
ENABLE_SAMPLE_DATA=true
# One Logto tenant holds identities for local development and production.
# Copy the endpoint and SPA app ID from the Logto application page.
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_API_RESOURCE=https://api.boring-things.local

# Imports and chat use this model for extraction, mapping, answers and web discovery.
# Keep the key on the server. Both settings are required to enable imports and chat.
OPENAI_API_KEY=
OPENAI_MODEL=
# Reference-document extraction defaults to OPENAI_MODEL.
DOCUMENT_EXTRACTION_MODEL=
IMPORT_TIMEOUT_MS=180000
IMPORT_TOOL_ROUNDS=4
DISCOVERY_TIMEOUT_MS=90000
DISCOVERY_SEARCH_CALLS=3
AI_MAX_OUTPUT_TOKENS=12000
CHAT_TIMEOUT_MS=180000
CHAT_TOOL_CALLS=12
