PORT=3000
HOST=127.0.0.1
# Routine HTTP request messages use trace severity.
LOG_LEVEL=info
# LOG_FORMAT defaults to pretty locally and json when NODE_ENV=production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
BLOB_DIRECTORY=.data/blobs
BLOB_STORAGE=local
# Hosted attachments use BLOB_STORAGE=s3 and a private Supabase bucket.
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set this in Render alongside its production DATABASE_URL; keep local DATABASE_URL unchanged.
SUPABASE_PROJECT_REF=
MAX_UPLOAD_BYTES=100000000
ENABLE_SAMPLE_DATA=true
# One Logto tenant holds identities for local development and production.
# Copy the endpoint and SPA app ID from the Logto application page.
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_API_RESOURCE=https://api.boring-things.local

# Imports and chat use models and reasoning configured in their task classes.
# Keep the key on the server; it enables imports and chat.
OPENAI_API_KEY=
# Optional server telemetry. Application tracing needs an Ingestion key; reports/setup need Full access.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Set false to disable server telemetry even when credentials are configured.
LANGFUSE_TRACING_ENABLED=true
# Required for OCR of images and PDF pages without embedded text; text analysis uses OpenAI.
GOOGLE_VISION_API_KEY=
# Open Icecat product lookup; participating brands only with free access.
ICECAT_ACCESS_TOKEN=
# UK vehicle registration lookup; requires a saved UK registration country.
ZYFY_API_KEY=
IMPORT_MAX_REQUESTS=60
IMPORT_MAX_RESOURCES=3
IMPORT_TIMEOUT_MS=300000
IMPORT_TOOL_ROUNDS=4
DISCOVERY_TIMEOUT_MS=90000
CHAT_TIMEOUT_MS=180000
CHAT_TOOL_CALLS=12
