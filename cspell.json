    "valuenow",
    "VESA",
    "WEXAMPLE",
    "wordmark",
    "Yaris",
    "Zanussi",
    "Zigbee"
  ],
  "minWordLength": 3,
  "validateDirectives": true,
  "overrides": [
    {
      "filename": ["scripts/cloud-postgres.sh", "cspell.json"],
      "words": ["ctlcluster", "euo", "lsclusters", "nologin", "psql", "rolname", "sed", "usr"]
    },
    {
      "filename": ["supabase/config.toml", "cspell.json"],
      "words": [
        "apikey",
        "EIP",
        "ETL",
        "hcaptcha",
        "messagebird",
        "migra",
        "oneshot",
        "orioledb",
        "pgdelta",
        "sendgrid",
        "signups",
        "SIWS",
        "textlocal",
        "timebox",
        "TOTP",
        "vonage",
        "webauthn",
        "workos"
      ]
    },
    {
      "filename": ["docs/requirements/research/*.csv", "cspell.json"],
      "words": ["ELEC"]
    },
    {
      "filename": ["server/src/providers/web/pdf.ts", "cspell.json"],
      "words": ["fff"]
    },
    {
      "filename": [".github/workflows/ci.yml", "cspell.json"],
      "words": ["isready", "nologin", "psql"]
    },
    {
      "filename": ["render.yaml", "cspell.json"],
      "words": ["num"]
    },
    {
      "filename": [
        "scripts/deploy.ts",
        "server/src/config.ts",
        "docs/setup/deployment.md",
        "cspell.json"
      ],
      "words": ["sslmode"]
    },
    {
      "filename": ["server/test/integration/job-lease.test.ts", "cspell.json"],
      "words": ["classid", "datname", "locktype", "objid", "oid"]
    }
  ]
}
