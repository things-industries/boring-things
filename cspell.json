  "version": "0.2",
  "language": "en,en-GB",
  "useGitignore": true,
  "enableGlobDot": true,
  "files": ["**/*"],
  "ignorePaths": ["**/.git/**", "pnpm-lock.yaml", "shared/api.ts", "**/*.png"],
