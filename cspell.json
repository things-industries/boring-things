    "Neff",
    "nosniff",
    "nums",
    "Ofgem",
    "oneline",
    "Opinium",
    "parallelisable",
    "pedelec",
    "Petplan",
    "pgvector",
    "PHEV",
    "plainto",
    "plpgsql",
    "POC",
    "PostgREST",
    "potencia",
    "Priya",
    "purchasables",
    "PWO",
    "recordset",
    "remixicon",
    "revisioned",
    "SDXC",
    "securitycode",
    "straplines",
    "strpos",
    "Supabase",
    "supavisor",
    "TBC",
    "TESTVIN",
    "textareas",
    "timestamptz",
    "towbar",
    "tradesperson",
    "TrueLayer",
    "tsc",
    "tsquery",
    "tsvector",
    "unbraked",
    "uncited",
    "unconfigured",
    "unretrieved",
    "unsandboxed",
    "unshippable",
    "unviewed",
    "upserts",
